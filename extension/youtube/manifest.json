{
  "manifest_version": 3,
  "name": "Astrum for YouTube",
  "version": "1.0.0",
  "description": "Shows what plays on YouTube in Astrum's island, and lets the island control it.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:43210/*", "https://www.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*"], "js": ["page.js"], "world": "MAIN", "run_at": "document_idle" },
    { "matches": ["https://www.youtube.com/*"], "js": ["bridge.js"], "run_at": "document_idle" }
  ],
  "action": { "default_title": "Astrum for YouTube", "default_popup": "popup.html" }
}
