{
  "name": "integration-app",
  "productName": "integrationApp",
  "version": "1.0.0",
  "description": "A desktop music widget: Spotify and YouTube Music, with Discord Rich Presence.",
  "main": "main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.5.1"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.garymcflarry.integrationapp",
    "productName": "integrationApp",
    "files": ["main.js", "preload.js", "lib/**", "app/**", "package.json"],
    "win": { "target": ["nsis", "portable"] },
    "mac": { "target": ["dmg"], "category": "public.app-category.music" },
    "linux": { "target": ["AppImage"], "category": "Audio" }
  }
}
